# Aplicação
PORT=3000
NODE_ENV=development

# Banco de Dados PostgreSQL (Porta mapeada pelo Docker: 5434)
DB_HOST=localhost
DB_PORT=5434
DB_USER=postgres
DB_PASS=postgres123
DB_NAME=emissor_nfe_db
# DB_LOGGING e DB_SYNCHRONIZE só têm efeito fora de produção
# (com NODE_ENV=production são forçados para false)
DB_LOGGING=true
DB_SYNCHRONIZE=true
# DB_MIGRATIONS_RUN=true aplica as migrations pendentes no boot da aplicação.
# Recomendado em produção (onde synchronize é sempre desligado); alternativa
# manual: docker compose exec api npm run migration:run:prod
# DB_MIGRATIONS_RUN=true

# Chave mestra de criptografia (para certificados A1 e senhas)
# OBRIGATÓRIA, mínimo 32 caracteres — a aplicação não sobe sem ela.
# Use SOMENTE hex/alfanumérico (gere com: openssl rand -hex 32).
# Caracteres especiais ($, %, aspas) são interpretados de forma diferente
# pelo dotenv e pelo env_file do Docker Compose, gerando chaves efetivas
# distintas entre container e execução local — e dados indecifráveis.
ENCRYPTION_KEY=troque-por-openssl-rand-hex-32

# Chave mestra administrativa (gestão de tenants via x-admin-key)
ADMIN_API_KEY=adm_troque-esta-chave

# Segurança da API
# CORS_ORIGINS: allowlist separada por vírgula (vazio = aberto em dev, bloqueado em produção)
# CORS_ORIGINS=https://app.exemplo.com
# TRUST_PROXY=true quando atrás de proxy reverso (rate limit por IP real)
THROTTLE_TTL=60
THROTTLE_LIMIT=120

# TLS na conexão com o Postgres (DB_SSL=true; DB_SSL_REJECT_UNAUTHORIZED=false p/ cert. autoassinado)
# DB_SSL=true

# Retenção de webhook_logs em dias (LGPD — 0 desativa o expurgo)
WEBHOOK_LOG_RETENTION_DAYS=90

# Retenção da trilha de auditoria (Art. 37 LGPD) em dias — default 5 anos; 0 desativa
AUDIT_LOG_RETENTION_DAYS=1825

# SEFAZ - Controle Global de Ambiente (2 = Homologação, 1 = Produção)
# SEFAZ_FORCE_HOMOLOGACAO=true força SEMPRE o ambiente de homologação (2), mesmo se o emitente estiver cadastrado como produção (1)
SEFAZ_FORCE_HOMOLOGACAO=true
SEFAZ_DEFAULT_AMBIENTE=2

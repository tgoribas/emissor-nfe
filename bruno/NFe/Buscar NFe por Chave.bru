meta {
  name: Buscar NFe por Chave
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/nfe/chave/{{chaveAcesso}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

tests {
  test("deve retornar status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("deve retornar a chave consultada", function () {
    expect(res.getBody().chaveAcesso).to.equal(bru.getEnvVar("chaveAcesso"));
  });
}

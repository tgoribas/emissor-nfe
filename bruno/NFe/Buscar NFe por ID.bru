meta {
  name: Buscar NFe por ID
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/nfe/{{notaFiscalId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

tests {
  test("deve retornar status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("deve retornar a nota correta", function () {
    expect(res.getBody().id).to.equal(bru.getEnvVar("notaFiscalId"));
  });
}

meta {
  name: Consultar Certificado do Emitente
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/certificados/{{emitenteId}}
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

tests {
  test("deve responder 200 ou 404 (sem certificado)", function () {
    expect([200, 404]).to.include(res.getStatus());
  });
}

meta {
  name: Listar Logs de Webhook
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/webhooks/logs
  body: none
  auth: none
}

headers {
  x-api-key: {{apiKey}}
}

tests {
  test("deve retornar status 200", function () {
    expect(res.getStatus()).to.equal(200);
  });

  test("deve retornar uma lista", function () {
    expect(res.getBody()).to.be.an("array");
  });
}
